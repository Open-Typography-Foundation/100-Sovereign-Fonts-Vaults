# Ignore font binaries
*.ttf
*.otf
*.woff
*.woff2
*.eot
*.svg
*.zip
*.tar.gz
*.deb
*.xz

# Ignore all numbered vault subdirectories (they contain hundreds of thousands of fonts)
[0-9]*_*/
!THEMATIC_CATEGORIES/

# Ignore temporary and cache directories
__pycache__/
*.pyc
.DS_Store
Thumbs.db
temp/
tmp/
*.tmp
*.log

# Whitelist root documentation, installers, indices, and scripts
!.gitignore
!README.md
!00_MASTER_INDEX.md
!font_browser.html
!BROWSE_VAULTS_OFFLINE.html
!vault_counts.json
!install.sh
!install.ps1
!Open_Foundation_Dashboard.bat
!LICENSE
